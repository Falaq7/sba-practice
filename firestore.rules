// SBA Workspace data access rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.username is string
        && request.resource.data.displayName is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 28;
      allow delete: if false;
    }

    match /users/{uid}/banks/{bankId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.ownerUid == uid
        && request.resource.data.title is string
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount > 0
        && request.resource.data.questionCount <= 500;
    }

    match /publicBanks/{bankId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility == 'public'
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount > 0
        && request.resource.data.questionCount <= 500;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.visibility == 'public';
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
